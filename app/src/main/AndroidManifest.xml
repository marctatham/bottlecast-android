<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- this permission is pulled in by one of the libs but isn't required by our application -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <!-- the offline banners follow the default network (common/connectivity) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- haptics compose the spec's primitives (common/ui/Haptics.kt) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- the daily reminder (spec §3.16), asked for from its rationale sheet -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Discover reads it to shake the cork loose, and offers tap and hold where there's none -->
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="false" />

    <application
        android:name=".BottleCastApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bottling">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Play services fetches ML Kit's language identification model at install, so Preview can
             tell which language a bottle is written in (spec §3.4b) -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="langid" />

        <!-- WorkManager starts from BottleCastApplication, so the reminder's worker can be injected -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
