<?xml version="1.0" encoding="utf-8"?>
<!-- The splash screen's icon (spec §1.1): the bottle glyph (ic_glyph_bottle) in glass, centred on
     the 288dp splash canvas so it sits inside the 192dp circle the system keeps for icons without
     a background. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <group
        android:translateX="12"
        android:translateY="12">
        <path
            android:pathData="M10,2h4"
            android:strokeColor="@color/splash_glyph"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="2" />
        <path
            android:pathData="M10.5,2v4c0,1 -3.5,2 -3.5,5v9a2,2 0,0 0,2 2h6a2,2 0,0 0,2 -2v-9c0,-3 -3.5,-4 -3.5,-5V2"
            android:strokeColor="@color/splash_glyph"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="2" />
        <path
            android:pathData="M9.5,14h5"
            android:strokeColor="@color/splash_glyph"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="2" />
    </group>
</vector>
