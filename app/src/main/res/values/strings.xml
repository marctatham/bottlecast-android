    <string name="login_required_title">Your guide to bottling messages</string>
    <string name="login_required_image_description">Safety First, sign in is required</string>

    <string name="login_required_description">Ready to cast your message adrift in a virtual bottle? 🌊 You’ll need to be signed in to set sail on this adventure. It’s not just about keeping the high seas clean; it’s also about making sure our virtual beach stays family-friendly!\n\nDon’t worry though, your secrets are safe with us! 🤐 We’ve got your back on privacy, and we’ll never spill your personally identifiable info into the message. Even if you choose to go incognito, your identity will remain as elusive as a message in a real bottle lost at sea! 🏴‍☠️⚓</string>
    <string name="login_required_button_primary">Agree and set sail</string>
    <string name="login_required_button_secondary">No thanks, I\'ll stay dry</string>

